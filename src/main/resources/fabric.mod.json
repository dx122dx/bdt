{
	"schemaVersion": 1,
	"id": "bdt",
	"version": "${version}",
	"name": "Billy's Debug Tools",
	"description": "A general-purpose client-side debugging toolkit. Provides a unified framework of debug actions and toggleable debug features, with built-in component packs that activate only when their target mod is present.",
	"authors": [
		"billy65536"
	],
	"contact": {
		
	},
	"license": "AGPL-3.0-only",
	"icon": "assets/bdt/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.billy65536.debugger.BdtMod"
		],
		"modmenu": [
			"com.billy65536.debugger.integration.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*",
		"chunkscanner": ">=1.1.0-dev-20260805.1"
	},
	"mixins": [
		"bdt.mixins.json",
		"bdt-chunkscanner.mixins.json"
	]
}
